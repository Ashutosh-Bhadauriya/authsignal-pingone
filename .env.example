# ─── Authsignal ──────────────────────────────────────────────────────────────
AUTHSIGNAL_SECRET=your_authsignal_api_secret_key
AUTHSIGNAL_TENANT_ID=your_authsignal_tenant_id
# Regional API URL: us | eu | au | ca
AUTHSIGNAL_API_URL=https://api.authsignal.com/v1
# Regional OIDC URL for federation
AUTHSIGNAL_OIDC_URL=https://us-connect.authsignal.com

# ─── PingOne ─────────────────────────────────────────────────────────────────
PINGONE_ENVIRONMENT_ID=your_pingone_environment_id
PINGONE_CLIENT_ID=your_pingone_app_client_id
PINGONE_CLIENT_SECRET=your_pingone_app_client_secret
# Regional base URLs: pingone.com | pingone.eu | pingone.ca | pingone.asia | pingone.com.au
PINGONE_AUTH_BASE_URL=https://auth.pingone.com
PINGONE_API_BASE_URL=https://api.pingone.com/v1

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=generate_a_random_32_char_string_here
SESSION_MAX_AGE=3600

# ─── DaVinci Bridge (optional - for DaVinci HTTP connector auth) ─────────────
DAVINCI_BRIDGE_API_KEY=generate_a_random_api_key_here
