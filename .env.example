# ─── Authsignal ──────────────────────────────────────────────────────────────
AUTHSIGNAL_SECRET=your_authsignal_api_secret_key
AUTHSIGNAL_TENANT_ID=your_authsignal_tenant_id
# Region: us | eu | au | ca (determines API + OIDC URLs automatically)
AUTHSIGNAL_REGION=us

# ─── PingOne ─────────────────────────────────────────────────────────────────
PINGONE_ENVIRONMENT_ID=your_pingone_environment_id
PINGONE_CLIENT_ID=your_pingone_app_client_id
PINGONE_CLIENT_SECRET=your_pingone_app_client_secret
# Region: NA | EU | CA | AP | AU (determines auth + API URLs automatically)
PINGONE_REGION=NA

# ─── Application ─────────────────────────────────────────────────────────────
# PORT=3000
# APP_BASE_URL=http://localhost:3000
# SESSION_SECRET=<auto-generated in development; required in production>
# SESSION_COOKIE_SECURE=false
