# ─── Authsignal ──────────────────────────────────────────────────────────────
AUTHSIGNAL_SECRET=your_authsignal_api_secret_key
AUTHSIGNAL_TENANT_ID=your_authsignal_tenant_id
# Region: us | eu | au | ca (determines API + OIDC URLs automatically)
AUTHSIGNAL_REGION=us

# ─── PingOne ─────────────────────────────────────────────────────────────────
PINGONE_ENVIRONMENT_ID=your_pingone_environment_id
PINGONE_CLIENT_ID=your_pingone_app_client_id
PINGONE_CLIENT_SECRET=your_pingone_app_client_secret
# Region: NA | EU | CA | AP | AU (determines auth + API URLs automatically)
PINGONE_REGION=NA

# ─── DaVinci application (demo app) ──────────────────────────────────────────
# When the first three are set, the demo app signs in through the DaVinci widget
# and this application's flow policy instead of the legacy PingOne login.
# DAVINCI_ENVIRONMENT_ID=<Company ID on the application's General tab>
# DAVINCI_API_KEY=<API Key on the application's General tab>
# DAVINCI_POLICY_ID=<Policy ID on the application's Flow Policy tab>
# Optional: only accept signed responses from this flow.
# DAVINCI_FLOW_ID=<Flow ID shown under the flow's name>

# ─── Application ─────────────────────────────────────────────────────────────
# PORT=3000
# APP_BASE_URL=http://localhost:3000
# SESSION_SECRET=<auto-generated in development; required in production>
# SESSION_COOKIE_SECURE=false

# ─── OIDC Provider (bridge as External IdP for PingOne / OIDC connector for DaVinci) ──
# The provider is enabled when client ID, client secret and redirect URIs are all set.
# Code of the Authsignal action (type: Flow) that runs the MFA step.
# AUTHSIGNAL_FLOW_ACTION_CODE=pingone-mfa
# Client credentials you enter in PingOne's External IdP (or DaVinci's OIDC connector).
# OIDC_PROVIDER_CLIENT_ID=pingone
# OIDC_PROVIDER_CLIENT_SECRET=<at least 32 random bytes, e.g. `openssl rand -hex 32`>
# Comma-separated, exact-match callback URLs PingOne shows when you add the IdP.
# OIDC_PROVIDER_REDIRECT_URIS=https://auth.pingone.com/<envId>/rp/callback/openid_connect
# Private RSA JWK (JSON) used to sign ID tokens. Required in production; in
# development a key is generated once and stored in .oidc-signing-key.json.
# OIDC_PROVIDER_SIGNING_KEY_JWK=
